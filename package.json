{
  "name": "quran-api-unified",
  "version": "0.1.0",
  "description": "One consistent interface over multiple Quran text, audio, translation, and tafsir APIs — provider selection and automatic fallback, framework-agnostic, dependency-free core.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run -c vitest.live.config.ts",
    "smoke:bundle": "pnpm build && node scripts/smoke-bundle.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pkg:check": "publint && attw --pack --profile node16",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "api:docs": "typedoc",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "keywords": [
    "quran",
    "quran-api",
    "sdk",
    "typescript",
    "adapters",
    "tafsir",
    "translation",
    "audio",
    "ayah",
    "surah"
  ],
  "author": "Ibrahim Rezq <ovic391@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Ibrahim-Rezq/quran-api-unified#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ibrahim-Rezq/quran-api-unified.git"
  },
  "bugs": {
    "url": "https://github.com/Ibrahim-Rezq/quran-api-unified/issues"
  },
  "peerDependencies": {
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.10.5",
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.0.5",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
